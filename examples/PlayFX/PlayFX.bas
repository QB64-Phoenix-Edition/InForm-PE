                ValidateMML = "Attack " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (0-100)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "\" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing decay number after '\' at position " + LTRIM$(STR$(i)) + "."
