            END IF
        ELSEIF c = "/" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing attack number after '/' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
