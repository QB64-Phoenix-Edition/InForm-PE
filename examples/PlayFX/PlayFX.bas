SUB InitDefaultVoiceSettings
    DIM i AS LONG
    FOR i = 1 TO 4
        Voice(i).enabled = _TRUE
        Voice(i).waveform = _IIF(i = 1, 9, _IIF(i = 2, 1, _IIF(i = 3, 3, 5)))
        Voice(i).waveParam = 50
        Voice(i).volume = _IIF(i = 1, 38, _IIF(i = 2, 32, _IIF(i = 3, 40, 28)))
        Voice(i).pan = _IIF(i = 1, 35, _IIF(i = 2, 65, 50))
        Voice(i).attack = 5
        Voice(i).decay = 15
        Voice(i).sustain = 70
        Voice(i).release = 10
        Voice(i).quickRamp = 10
        Voice(i).tempo = 140
        Voice(i).octave = _IIF(i = 1, 2, _IIF(i = 2, 2, _IIF(i = 3, 0, 0)))
        Voice(i).length = 4
        Voice(i).articulation = 1 ' Normal MN
    NEXT i
END SUB

FUNCTION GetVoiceMMLTB& (v AS LONG)
    SELECT CASE v
        CASE 1: GetVoiceMMLTB = Voice1MMLTB
        CASE 2: GetVoiceMMLTB = Voice2MMLTB
        CASE 3: GetVoiceMMLTB = Voice3MMLTB
        CASE 4: GetVoiceMMLTB = Voice4MMLTB
    END SELECT
END FUNCTION

SUB SyncMixerControlsFromVoice (v AS LONG)
    SELECT CASE v
        CASE 1: Control(Voice1EnableCB).Value = Voice(1).enabled
        CASE 2: Control(Voice2EnableCB).Value = Voice(2).enabled
        CASE 3: Control(Voice3EnableCB).Value = Voice(3).enabled
        CASE 4: Control(Voice4EnableCB).Value = Voice(4).enabled
    END SELECT
END SUB

SUB SyncComposerFromActiveVoice
    DIM v AS LONG: v = activeCompVoice
    IF v < 1 _ORELSE v > 4 THEN v = 1

    Control(CompVoiceDL).Value = v
    Control(CompOctaveDL).Value = Voice(v).octave + 1 ' 0..6 maps to 1..7
    Control(SynthWaveDL).Value = Voice(v).waveform
    Control(SynthDutySlider).Value = Voice(v).waveParam
    SetCaption SynthDutyValLB, LTRIM$(STR$(Voice(v).waveParam)) + "%"

    Control(SynthVolSlider).Value = Voice(v).volume
    SetCaption SynthVolValLB, LTRIM$(STR$(Voice(v).volume))

    Control(SynthPanSlider).Value = Voice(v).pan

    Control(AttackSlider).Value = Voice(v).attack
    SetCaption AttackValLB, LTRIM$(STR$(Voice(v).attack)) + "%"

    Control(DecaySlider).Value = Voice(v).decay
    SetCaption DecayValLB, LTRIM$(STR$(Voice(v).decay)) + "%"

    Control(SustainSlider).Value = Voice(v).sustain
    SetCaption SustainValLB, LTRIM$(STR$(Voice(v).sustain)) + "%"

    Control(ReleaseSlider).Value = Voice(v).release
    SetCaption ReleaseValLB, LTRIM$(STR$(Voice(v).release)) + "%"

    Control(QuickRampSlider).Value = Voice(v).quickRamp
    SetCaption QuickRampValLB, LTRIM$(STR$(Voice(v).quickRamp)) + "%"

    updatingText = _TRUE
    Text(ActiveVoiceMMLTB) = Text(GetVoiceMMLTB(v))
    updatingText = _FALSE
    SetCaption ActiveVoiceHeaderLB, "Channel " + LTRIM$(STR$(v)) + " MML Stream:"
    SetCaption ActiveVoiceStatusLB, "Channel " + LTRIM$(STR$(v)) + " ready."
END SUB

SUB ApplyComposerToActiveVoice
    DIM v AS LONG: v = activeCompVoice
    IF v < 1 _ORELSE v > 4 THEN v = 1

    Voice(v).waveform = Control(SynthWaveDL).Value
    Voice(v).waveParam = Control(SynthDutySlider).Value
    Voice(v).volume = Control(SynthVolSlider).Value
    Voice(v).pan = Control(SynthPanSlider).Value
    Voice(v).attack = Control(AttackSlider).Value
    Voice(v).decay = Control(DecaySlider).Value
    Voice(v).sustain = Control(SustainSlider).Value
    Voice(v).release = Control(ReleaseSlider).Value
    Voice(v).quickRamp = Control(QuickRampSlider).Value
    Voice(v).octave = Control(CompOctaveDL).Value - 1

    SyncMixerControlsFromVoice v
    updatingText = _TRUE
    Text(GetVoiceMMLTB(v)) = Text(ActiveVoiceMMLTB)
    updatingText = _FALSE
    SetCaption ActiveVoiceStatusLB, "Channel " + LTRIM$(STR$(v)) + " settings applied."
END SUB

FUNCTION BuildVoiceSetupHeader$ (v AS LONG)
    DIM h AS STRING
    h = "@" + LTRIM$(STR$(Voice(v).waveform))
    IF Voice(v).waveform = 8 _ORELSE Voice(v).waveform = 9 THEN
        h = h + "Y" + LTRIM$(STR$(Voice(v).waveParam))
    END IF
    h = h + "V" + LTRIM$(STR$(Voice(v).volume))
    h = h + "S" + LTRIM$(STR$(Voice(v).pan))
    IF Voice(v).quickRamp > 0 THEN
        h = h + "Q" + LTRIM$(STR$(Voice(v).quickRamp))
    ELSE
        h = h + "/" + LTRIM$(STR$(Voice(v).attack)) + "\" + LTRIM$(STR$(Voice(v).decay)) + "^" + LTRIM$(STR$(Voice(v).sustain)) + "_" + LTRIM$(STR$(Voice(v).release))
    END IF
    BuildVoiceSetupHeader = h + " "
END FUNCTION

FUNCTION BuildFinalVoiceString$ (v AS LONG)
    IF NOT Voice(v).enabled THEN
        BuildFinalVoiceString = ""
        EXIT FUNCTION
    END IF

    DIM rawMML AS STRING: rawMML = _TRIM$(Text(GetVoiceMMLTB(v)))
    IF LEN(rawMML) = 0 THEN
        BuildFinalVoiceString = ""
        EXIT FUNCTION
    END IF

    DIM res AS STRING
    res = "MB "

    ' If the raw MML doesn't already specify tempo, add master tempo
    IF INSTR(UCASE$(rawMML), "T") = 0 THEN
        res = res + "T" + LTRIM$(STR$(Control(CompTempoSlider).Value)) + " "
    END IF



    res = res + rawMML
    BuildFinalVoiceString = res
END FUNCTION

SUB PlayAllVoices
    DIM AS STRING v1, v2, v3, v4
    v1 = BuildFinalVoiceString(1)
    v2 = BuildFinalVoiceString(2)
    v3 = BuildFinalVoiceString(3)
    v4 = BuildFinalVoiceString(4)

    IF LEN(v1) = 0 _ANDALSO LEN(v2) = 0 _ANDALSO LEN(v3) = 0 _ANDALSO LEN(v4) = 0 THEN
        MessageBox "No active channels to play." + _CHR_LF + _CHR_LF + "Please enable at least one channel with MML text.", "PlayFX - Player", MsgBox_OkOnly OR MsgBox_Information
        EXIT SUB
    END IF

    ' 1. Pre-validate each active voice stream for syntax and range errors
    DIM AS LONG i
    DIM AS STRING vStr, valErr, combinedErr
    FOR i = 1 TO 4
        SELECT CASE i
            CASE 1: vStr = v1
            CASE 2: vStr = v2
            CASE 3: vStr = v3
            CASE 4: vStr = v4
        END SELECT
        IF LEN(vStr) > 0 THEN
            valErr = ValidateMML(vStr)
            IF LEN(valErr) > 0 THEN
                combinedErr = combinedErr + "* Channel " + LTRIM$(STR$(i)) + ": " + valErr + _CHR_LF
            END IF
        END IF
    NEXT i

    IF LEN(combinedErr) > 0 THEN
        ' MML syntax error detected
        MessageBox "The following MML syntax errors were found:" + _CHR_LF + _CHR_LF + combinedErr + _CHR_LF + "Please correct them and try again.", "PlayFX - MML Syntax Error", MsgBox_OkOnly OR MsgBox_Critical
        EXIT SUB
    END IF

    ' 2. Execute PLAY with local runtime error trap
    mmlHadError = _FALSE
    mmlErrorMessage = ""
    ON ERROR GOTO _NEWHANDLER MMLErrorHandler
    PLAY v1, v2, v3, v4
    ON ERROR GOTO _LASTHANDLER

    IF mmlHadError THEN
        ' MML runtime error
        MessageBox "A runtime error occurred during MML playback:" + _CHR_LF + _CHR_LF + mmlErrorMessage + _CHR_LF + _CHR_LF + "Please verify all MML parameters.", "PlayFX - MML Playback Error", MsgBox_OkOnly OR MsgBox_Critical
    ELSE
        ' Playing 4-voice MML tune
    END IF
END SUB

FUNCTION ValidateMML$ (mml AS STRING)
    DIM AS LONG i, n, length
    DIM AS STRING c, nextC
    length = LEN(mml)
    i = 1

    WHILE i <= length
        c = UCASE$(MID$(mml, i, 1))

        IF c = " " _ORELSE c = CHR$(9) _ORELSE c = CHR$(10) _ORELSE c = CHR$(13) _ORELSE c = ";" THEN
            i = i + 1
        ELSEIF c >= "A" _ANDALSO c <= "G" THEN
            i = i + 1
            IF i <= length THEN
                nextC = MID$(mml, i, 1)
                IF nextC = "#" _ORELSE nextC = "+" _ORELSE nextC = "-" THEN
                    i = i + 1
                END IF
            END IF
            IF i <= length THEN
                nextC = MID$(mml, i, 1)
                IF nextC >= "0" _ANDALSO nextC <= "9" THEN
                    n = MML_ReadNumber(mml, i)
                    IF n < 1 _ORELSE n > 64 THEN
                        ValidateMML = "Note length " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (1-64)."
                        EXIT FUNCTION
                    END IF
                END IF
            END IF
            WHILE i <= length _ANDALSO MID$(mml, i, 1) = "."
                i = i + 1
            WEND
        ELSEIF c = "N" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing note number after 'N' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 0 _ORELSE n > 84 THEN
                ValidateMML = "Note number " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (0-84)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "O" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing octave number after 'O' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 0 _ORELSE n > 6 THEN
                ValidateMML = "Octave " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (0-6)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "<" _ORELSE c = ">" THEN
            i = i + 1
        ELSEIF c = "L" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing length number after 'L' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 1 _ORELSE n > 64 THEN
                ValidateMML = "Length " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (1-64)."
                EXIT FUNCTION
            END IF
            WHILE i <= length _ANDALSO MID$(mml, i, 1) = "."
                i = i + 1
            WEND
        ELSEIF c = "P" _ORELSE c = "R" THEN
            i = i + 1
            IF i <= length THEN
                nextC = MID$(mml, i, 1)
                IF nextC >= "0" _ANDALSO nextC <= "9" THEN
                    n = MML_ReadNumber(mml, i)
                    IF n < 1 _ORELSE n > 64 THEN
                        ValidateMML = "Rest duration " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (1-64)."
                        EXIT FUNCTION
                    END IF
                END IF
            END IF
            WHILE i <= length _ANDALSO MID$(mml, i, 1) = "."
                i = i + 1
            WEND
        ELSEIF c = "T" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing tempo number after 'T' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 32 _ORELSE n > 255 THEN
                ValidateMML = "Tempo " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (32-255 BPM)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "M" THEN
            i = i + 1
            IF i <= length THEN
                nextC = UCASE$(MID$(mml, i, 1))
                IF nextC = "N" _ORELSE nextC = "L" _ORELSE nextC = "S" _ORELSE nextC = "B" _ORELSE nextC = "F" THEN
                    i = i + 1
                ELSE
                    ValidateMML = "Invalid music style 'M" + nextC + "' at position " + LTRIM$(STR$(i)) + ". Expected MN, ML, MS, MB, or MF."
                    EXIT FUNCTION
                END IF
            ELSE
                ValidateMML = "Incomplete 'M' command at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
        ELSEIF c = "V" THEN
            i = i + 1
            IF i <= length THEN
                nextC = MID$(mml, i, 1)
                IF nextC = "+" _ORELSE nextC = "-" THEN
                    i = i + 1
                ELSEIF nextC >= "0" _ANDALSO nextC <= "9" THEN
                    n = MML_ReadNumber(mml, i)
                    IF n < 0 _ORELSE n > 100 THEN
                        ValidateMML = "Volume " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (0-100)."
                        EXIT FUNCTION
                    END IF
                ELSE
                    ValidateMML = "Invalid volume parameter at position " + LTRIM$(STR$(i)) + ". Expected 0-100, +, or -."
                    EXIT FUNCTION
                END IF
            ELSE
                ValidateMML = "Incomplete 'V' command at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
        ELSEIF c = "W" _ORELSE c = "@" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing waveform number after '" + c + "' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 1 _ORELSE n > 10 THEN
                ValidateMML = "Waveform " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (1-10)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "Y" THEN
            i = i + 1
            IF i > length _ORELSE (MID$(mml, i, 1) < "0" _ORELSE MID$(mml, i, 1) > "9") THEN
                ValidateMML = "Missing parameter number after 'Y' at position " + LTRIM$(STR$(i)) + "."
                EXIT FUNCTION
            END IF
            n = MML_ReadNumber(mml, i)
            IF n < 0 _ORELSE n > 100 THEN
                ValidateMML = "Waveform parameter " + LTRIM$(STR$(n)) + " at position " + LTRIM$(STR$(i)) + " is out of range (0-100)."
                EXIT FUNCTION
            END IF
        ELSEIF c = "S" THEN
            i = i + 1
            IF i <= length THEN
                nextC = MID$(mml, i, 1)
                IF nextC = "+" _ORELSE nextC = "-" THEN
                    i = i + 1
                ELSEIF nextC >= "0" _ANDALSO nextC <= "9" THEN
