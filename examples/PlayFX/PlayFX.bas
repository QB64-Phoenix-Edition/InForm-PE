SUB __UI_Click (id AS LONG)
    SELECT CASE id
        CASE PlayFXDesigner

        CASE MasterFrame

        CASE MainTabs

        CASE PresetLB

        CASE PresetsDL

        CASE Voice1HeaderLB

        CASE Voice1MeterLB

        CASE V1MMLLB

        CASE Voice1MMLTB

        CASE Voice2HeaderLB

        CASE Voice2MeterLB

        CASE V2MMLLB

        CASE Voice2MMLTB

        CASE Voice3HeaderLB

        CASE Voice3MeterLB

        CASE V3MMLLB

        CASE Voice3MMLTB

        CASE Voice4HeaderLB

        CASE Voice4MeterLB

        CASE V4MMLLB

        CASE Voice4MMLTB

        CASE CompTargetLB

        CASE CompVoiceDL

        CASE CompOctaveLB

        CASE CompOctaveDL

        CASE CompLengthLB

        CASE CompLengthDL

        CASE CompArtLB

        CASE CompArtDL

        CASE CompTempoLB

        CASE CompTempoSlider

        CASE CompTempoValLB

        CASE PianoHeaderLB

        CASE SynthHeaderLB

        CASE SynthWaveLB

        CASE SynthWaveDL

        CASE SynthDutyLB

        CASE SynthDutySlider

        CASE SynthDutyValLB

        CASE SynthVolLB

        CASE SynthVolSlider

        CASE SynthVolValLB

        CASE SynthPanLB

        CASE SynthPanSlider

        CASE AttackLB

        CASE AttackSlider

        CASE AttackValLB

        CASE DecayLB

        CASE DecaySlider

        CASE DecayValLB

        CASE SustainLB

        CASE SustainSlider

        CASE SustainValLB

        CASE ReleaseLB

        CASE ReleaseSlider

        CASE ReleaseValLB

        CASE QuickRampLB

        CASE QuickRampSlider

        CASE QuickRampValLB

        CASE ActiveVoiceHeaderLB

        CASE ActiveVoiceMMLTB

        CASE ActiveVoiceStatusLB

        CASE PlayBT
            PlayAllVoices

        CASE CopyCodeBT
            CopyQB64CodeToClipboard

            ' Channel 1-4 Mixer Controls
        CASE Voice1EnableCB: Voice(1).enabled = Control(Voice1EnableCB).Value
        CASE Voice1SoloBT: SoloVoice 1
        CASE Voice1ClearBT: ClearVoiceMML 1

        CASE Voice2EnableCB: Voice(2).enabled = Control(Voice2EnableCB).Value
        CASE Voice2SoloBT: SoloVoice 2
        CASE Voice2ClearBT: ClearVoiceMML 2

        CASE Voice3EnableCB: Voice(3).enabled = Control(Voice3EnableCB).Value
        CASE Voice3SoloBT: SoloVoice 3
        CASE Voice3ClearBT: ClearVoiceMML 3

        CASE Voice4EnableCB: Voice(4).enabled = Control(Voice4EnableCB).Value
        CASE Voice4SoloBT: SoloVoice 4
        CASE Voice4ClearBT: ClearVoiceMML 4

            ' Interactive Piano Keyboard Keys
        CASE KeyC: AuditionTone "C", 0
        CASE KeyCs: AuditionTone "C#", 0
        CASE KeyD: AuditionTone "D", 0
        CASE KeyDs: AuditionTone "D#", 0
        CASE KeyE: AuditionTone "E", 0
        CASE KeyF: AuditionTone "F", 0
        CASE KeyFs: AuditionTone "F#", 0
        CASE KeyG: AuditionTone "G", 0
        CASE KeyGs: AuditionTone "G#", 0
        CASE KeyA: AuditionTone "A", 0
        CASE KeyAs: AuditionTone "A#", 0
        CASE KeyB: AuditionTone "B", 0

        CASE KeyC2: AuditionTone "C", 1
        CASE KeyCs2: AuditionTone "C#", 1
        CASE KeyD2: AuditionTone "D", 1
        CASE KeyDs2: AuditionTone "D#", 1
        CASE KeyE2: AuditionTone "E", 1
        CASE KeyF2: AuditionTone "F", 1
        CASE KeyFs2: AuditionTone "F#", 1
        CASE KeyG2: AuditionTone "G", 1
        CASE KeyGs2: AuditionTone "G#", 1
        CASE KeyA2: AuditionTone "A", 1
        CASE KeyAs2: AuditionTone "A#", 1
        CASE KeyB2: AuditionTone "B", 1

        CASE KeyRest
            DIM rLen AS LONG
            SELECT CASE Control(CompLengthDL).Value
                CASE 1: rLen = 1
                CASE 2: rLen = 2
                CASE 3: rLen = 4
                CASE 4: rLen = 8
                CASE 5: rLen = 16
                CASE 6: rLen = 32
                CASE 7: rLen = 64
                CASE ELSE: rLen = 4
            END SELECT
            AppendNoteToActiveVoice "P" + LTRIM$(STR$(rLen))

        CASE KeyDot
            AppendNoteToActiveVoice "."

        CASE KeyOctDown
            AppendNoteToActiveVoice "<"

        CASE KeyOctUp
            AppendNoteToActiveVoice ">"

        CASE KeyTie
            AppendNoteToActiveVoice ","

        CASE KeyInsertHeader
            AppendNoteToActiveVoice BuildVoiceSetupHeader(activeCompVoice)

        CASE KeyBackspace
            DIM bText AS STRING: bText = _TRIM$(Text(GetVoiceMMLTB(activeCompVoice)))
            DIM lastSpace AS LONG: lastSpace = _INSTRREV(bText, " ")
            IF lastSpace > 0 THEN
                bText = LEFT$(bText, lastSpace - 1)
            ELSE
                bText = ""
            END IF
            updatingText = _TRUE
            Text(GetVoiceMMLTB(activeCompVoice)) = bText
            Text(ActiveVoiceMMLTB) = bText
            updatingText = _FALSE
            SetCaption ActiveVoiceStatusLB, "Removed last token."

        CASE KeyClearMML
            ClearVoiceMML activeCompVoice

            ' Composer Synth Buttons
        CASE ApplySynthBT
            ApplyComposerToActiveVoice

        CASE AuditionVoiceBT
            AuditionTone "C", 0

        CASE PlayActiveVoiceBT
            DIM oneVoiceMML AS STRING
            oneVoiceMML = BuildFinalVoiceString(activeCompVoice)
            IF LEN(oneVoiceMML) > 0 THEN
                DIM valOneErr AS STRING
                valOneErr = ValidateMML(oneVoiceMML)
                IF LEN(valOneErr) > 0 THEN
                    SetCaption ActiveVoiceStatusLB, "MML Error: " + valOneErr
                    MessageBox "MML syntax error in Channel " + LTRIM$(STR$(activeCompVoice)) + ":" + _CHR_LF + _CHR_LF + valOneErr + _CHR_LF + _CHR_LF + "Please correct it and try again.", "PlayFX - MML Syntax Error", MsgBox_OkOnly OR MsgBox_Critical
                    EXIT SUB
                END IF

                mmlHadError = _FALSE
                mmlErrorMessage = ""
                ON ERROR GOTO _NEWHANDLER MMLErrorHandler
                PLAY oneVoiceMML
                ON ERROR GOTO _LASTHANDLER

                IF mmlHadError THEN
                    SetCaption ActiveVoiceStatusLB, "MML runtime error: " + mmlErrorMessage
                    MessageBox "A runtime error occurred during playback of Channel " + LTRIM$(STR$(activeCompVoice)) + ":" + _CHR_LF + _CHR_LF + mmlErrorMessage, "PlayFX - MML Playback Error", MsgBox_OkOnly OR MsgBox_Critical
                ELSE
                    SetCaption ActiveVoiceStatusLB, "Playing Channel " + LTRIM$(STR$(activeCompVoice)) + "..."
                END IF
            ELSE
                SetCaption ActiveVoiceStatusLB, "Channel " + LTRIM$(STR$(activeCompVoice)) + " is empty or muted."
            END IF
    END SELECT
END SUB

